{
	"name": "@abcnews/palette",
	"version": "1.0.2",
	"scripts": {
		"dev": "concurrently \"vite dev\" \"svelte-package --watch\"",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-package",
		"test": "",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
		"release": "release-it",
		"generate-docs": "svelte-kit sync && typedoc"
	},
	"engines": {
		"node": ">=18"
	},
	"release-it": {
		"hooks": {
			"after:bump": "npm run package && npm run generate-docs && git add docs"
		},
		"git": {
			"requireBranch": "main",
			"tagName": "${version}"
		},
		"github": {
			"release": true,
			"releaseName": "${version}",
			"autoGenerate": true
		}
	},
	"type": "module",
	"dependencies": {
		"d3-interpolate": "^3.0.1",
		"d3-scale": "^4.0.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/d3-array": "^3.0.2",
		"@types/d3-color": "^3.1.0",
		"@types/d3-dsv": "^3.0.0",
		"@types/d3-interpolate": "^3.0.1",
		"@types/d3-scale": "^4.0.2",
		"@types/node": "^26.3.0",
		"concurrently": "^10.0.5",
		"d3-array": "^3.1.1",
		"d3-color": "^3.1.0",
		"d3-dsv": "^3.0.1",
		"layercake": "^10.0.0",
		"micromatch": "^4.0.4",
		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^4.1.1",
		"release-it": "^21.1.3",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.0",
		"tslib": "^2.3.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.14.1",
		"typescript": "^6.0.3",
		"typescript-transform-extensions": "^1.0.1",
		"vite": "^8.3.8"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"./dist",
		"./docs"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	}
}
